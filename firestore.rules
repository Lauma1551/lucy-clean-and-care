rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && (
        (
          request.auth.token.email_verified == true &&
          'email' in request.auth.token &&
          request.auth.token.email is string &&
          request.auth.token.email.lower() in ['aumalucy015@gmail.com', 'lucycleanandcare@gmail.com']
        ) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidBooking(data) {
      return data.keys().hasAll([
        'referenceCode',
        'fullName',
        'phoneNumber',
        'email',
        'locationEstate',
        'houseType',
        'cleaningType',
        'preferredDate',
        'preferredTime',
        'productPreference',
        'instructions',
        'status',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'referenceCode',
        'fullName',
        'phoneNumber',
        'email',
        'locationEstate',
        'houseType',
        'cleaningType',
        'preferredDate',
        'preferredTime',
        'productPreference',
        'instructions',
        'status',
        'createdAt',
        'updatedAt'
      ])
      && data.referenceCode is string
      && data.referenceCode.size() >= 8
      && data.referenceCode.size() <= 24
      && data.referenceCode.matches('^LCC-[0-9]{4}-[A-Z0-9]{4,8}$')
      && data.fullName is string
      && data.fullName.size() >= 2
      && data.fullName.size() <= 120
      && data.phoneNumber is string
      && data.phoneNumber.size() >= 9
      && data.phoneNumber.size() <= 30
      && data.email is string
      && data.email.size() <= 120
      && data.locationEstate is string
      && data.locationEstate.size() >= 2
      && data.locationEstate.size() <= 160
      && data.houseType in [
        'Bedsitter',
        'One Bedroom',
        'Two Bedrooms',
        'Three Bedrooms',
        'Four Bedrooms and Above'
      ]
      && data.cleaningType in [
        'Standard Home Cleaning',
        'Deep Cleaning',
        'Kitchen and Bathroom Cleaning',
        'Move-In and Move-Out Cleaning'
      ]
      && data.preferredDate is string
      && data.preferredDate.size() == 10
      && data.preferredDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && data.preferredTime is string
      && data.preferredTime.size() >= 3
      && data.preferredTime.size() <= 60
      && data.productPreference in [
        'Lucy Clean & Care brings cleaning products and equipment',
        'Customer provides cleaning products'
      ]
      && data.instructions is string
      && data.instructions.size() <= 1000
      && data.status in ['pending', 'confirmed', 'completed', 'cancelled']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidService(data) {
      return data.keys().hasAll([
        'id',
        'order',
        'title',
        'houseTypeValue',
        'cleaningTypeValue',
        'description',
        'imageUrl',
        'available',
        'pricingNote',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'id',
        'order',
        'title',
        'houseTypeValue',
        'cleaningTypeValue',
        'description',
        'imageUrl',
        'available',
        'pricingNote',
        'updatedAt'
      ])
      && isValidId(data.id)
      && (data.order is int || data.order is float)
      && data.order >= 1
      && data.order <= 200
      && data.title is string
      && data.title.size() >= 2
      && data.title.size() <= 90
      && data.houseTypeValue is string
      && data.houseTypeValue.size() >= 2
      && data.houseTypeValue.size() <= 60
      && data.cleaningTypeValue is string
      && data.cleaningTypeValue.size() >= 2
      && data.cleaningTypeValue.size() <= 80
      && data.description is string
      && data.description.size() >= 5
      && data.description.size() <= 320
      && data.imageUrl is string
      && data.imageUrl.size() >= 1
      && data.imageUrl.size() <= 300
      && data.available is bool
      && data.pricingNote is string
      && data.pricingNote.size() <= 180
      && data.updatedAt is timestamp
      && data.updatedAt == request.time;
    }

    function isValidPricingTier(data) {
      return data.keys().hasAll([
        'id',
        'order',
        'label',
        'houseTypeValue',
        'priceKes',
        'note',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'id',
        'order',
        'label',
        'houseTypeValue',
        'priceKes',
        'note',
        'updatedAt'
      ])
      && isValidId(data.id)
      && (data.order is int || data.order is float)
      && data.order >= 1
      && data.order <= 200
      && data.label is string
      && data.label.size() >= 2
      && data.label.size() <= 80
      && data.houseTypeValue is string
      && data.houseTypeValue.size() >= 2
      && data.houseTypeValue.size() <= 60
      && (
        data.priceKes == null ||
        ((data.priceKes is int || data.priceKes is float) && data.priceKes >= 0 && data.priceKes <= 1000000)
      )
      && data.note is string
      && data.note.size() <= 180
      && data.updatedAt is timestamp
      && data.updatedAt == request.time;
    }

    function isValidSocialLinks(links) {
      return links is map
      && links.keys().hasAll(['instagram', 'facebook', 'tiktok', 'x'])
      && links.keys().hasOnly(['instagram', 'facebook', 'tiktok', 'x'])
      && links.instagram is string && links.instagram.size() <= 300
      && links.facebook is string && links.facebook.size() <= 300
      && links.tiktok is string && links.tiktok.size() <= 300
      && links.x is string && links.x.size() <= 300;
    }

    function isValidSiteConfig(data) {
      return data.keys().hasAll([
        'businessName',
        'logoText',
        'tagline',
        'founderName',
        'founderBio',
        'city',
        'whatsappNumber',
        'telephone',
        'email',
        'serviceAreas',
        'productsPolicyNote',
        'socialLinks',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'businessName',
        'logoText',
        'tagline',
        'founderName',
        'founderBio',
        'city',
        'whatsappNumber',
        'telephone',
        'email',
        'serviceAreas',
        'productsPolicyNote',
        'socialLinks',
        'updatedAt'
      ])
      && data.businessName is string && data.businessName.size() >= 2 && data.businessName.size() <= 80
      && data.logoText is string && data.logoText.size() >= 2 && data.logoText.size() <= 80
      && data.tagline is string && data.tagline.size() >= 2 && data.tagline.size() <= 140
      && data.founderName is string && data.founderName.size() >= 2 && data.founderName.size() <= 100
      && data.founderBio is string && data.founderBio.size() >= 10 && data.founderBio.size() <= 1500
      && data.city is string && data.city.size() >= 2 && data.city.size() <= 120
      && data.whatsappNumber is string && data.whatsappNumber.size() <= 25
      && data.telephone is string && data.telephone.size() <= 40
      && data.email is string && data.email.size() <= 120
      && data.serviceAreas is string && data.serviceAreas.size() >= 2 && data.serviceAreas.size() <= 400
      && data.productsPolicyNote is string && data.productsPolicyNote.size() >= 2 && data.productsPolicyNote.size() <= 400
      && isValidSocialLinks(data.socialLinks)
      && data.updatedAt is timestamp
      && data.updatedAt == request.time;
    }

    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && isOwner();
      allow list: if isOwner();
      allow create: if isValidId(bookingId)
        && isValidBooking(incoming())
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(bookingId)
        && isOwner()
        && isValidBooking(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isValidId(bookingId) && isOwner();
    }

    match /services/{serviceId} {
      allow get: if isValidId(serviceId);
      allow list: if true;
      allow create, update: if isValidId(serviceId)
        && isOwner()
        && isValidService(incoming())
        && incoming().id == serviceId;
      allow delete: if isValidId(serviceId) && isOwner();
    }

    match /pricing/{pricingId} {
      allow get: if isValidId(pricingId);
      allow list: if true;
      allow create, update: if isValidId(pricingId)
        && isOwner()
        && isValidPricingTier(incoming())
        && incoming().id == pricingId;
      allow delete: if isValidId(pricingId) && isOwner();
    }

    match /siteConfig/{configId} {
      allow get: if isValidId(configId);
      allow list: if true;
      allow create, update: if isValidId(configId)
        && configId == 'main'
        && isOwner()
        && isValidSiteConfig(incoming());
      allow delete: if false;
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner() || (isSignedIn() && request.auth.uid == adminId));
      allow list: if isOwner();
      allow create, update, delete: if false;
    }
  }
}
