# Firebase Web App Configuration (Required for Netlify & Vite builds)
# Set these in Netlify -> Site configuration -> Environment variables
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"

# Optional: Specify a named Firestore database ID (leave empty for "(default)")
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# Optional: Comma-separated list of authorized owner emails for UI pre-check
# Note: Actual authorization is enforced server-side in firestore.rules and admins/{uid}
VITE_OWNER_EMAILS="aumalucy015@gmail.com,lucycleanandcare@gmail.com"
