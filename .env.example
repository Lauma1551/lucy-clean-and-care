# Firebase Web App Configuration (Required for Netlify & Vite builds)
# Set these in Netlify -> Site configuration -> Environment variables
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"

# Optional: Specify a named Firestore database ID (leave empty for "(default)")
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# Authorized owner email enforced in firestore.rules and frontend auth guards
VITE_OWNER_EMAIL="aumalucy015@gmail.com"

# -----------------------------------------------------------------------------
# Server-side WhatsApp Business Platform (Meta Cloud API) Credentials
# NEVER prefix these with VITE_ — keep them server-side only in Netlify env vars
# -----------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_OWNER_PHONE="254746022851"
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_DEFAULT_COUNTRY_CODE="254"

# Delivery mode: "template" (recommended for business-initiated notifications) or "text"
WHATSAPP_MESSAGE_MODE="template"
WHATSAPP_TEMPLATE_LANGUAGE="en"

# Approved Meta WhatsApp message template names (create in Meta WhatsApp Manager)
WHATSAPP_TEMPLATE_OWNER_NEW_BOOKING=""
WHATSAPP_TEMPLATE_OWNER_CANCEL_REQUEST=""
WHATSAPP_TEMPLATE_OWNER_RESCHEDULE_REQUEST=""
WHATSAPP_TEMPLATE_CUSTOMER_CONFIRMED=""
WHATSAPP_TEMPLATE_CUSTOMER_RESCHEDULED=""
WHATSAPP_TEMPLATE_CUSTOMER_CANCELLED=""
